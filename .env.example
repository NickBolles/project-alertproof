# AlertProof local development configuration.
# Real Shopify Partner credentials are REQUIRED only for live OAuth/webhooks.
SHOPIFY_API_KEY=dev-key
SHOPIFY_API_SECRET=dev-secret
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_orders,write_orders,read_products,read_inventory

# REQUIRED. Provided by docker-compose.yml. Production must also use PostgreSQL.
DATABASE_URL=postgresql://alertproof:alertproof@localhost:5432/alertproof?schema=public
# Optional. CI and DB integration tests set this to a separate PostgreSQL database.
TEST_DATABASE_URL=

# MOCKABLE. Leave blank to write email sends to MockOutbox.
POSTMARK_API_TOKEN=
# MOCKABLE. Leave blank to accept only local mock status events in later phases.
POSTMARK_WEBHOOK_SECRET=
EMAIL_FROM=alerts@alertproof.test

# MOCKABLE. Leave all blank to write SMS sends to MockOutbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Local values only. Generate and rotate both values before production.
CRON_SECRET=alertproof-local-cron-secret
# Exactly 32 bytes, base64 encoded. This example decodes to 32 zero bytes; DO NOT use in production.
ALERTPROOF_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Dev/test switches.
ALERTPROOF_FORCE_MOCKS=1
# Auth bypass requires BOTH AUTH_MODE=mock and ALERTPROOF_AUTH_BYPASS=1,
# and still refuses to arm outside development/test or with real Shopify credentials.
AUTH_MODE=shopify
ALERTPROOF_AUTH_BYPASS=0
DEV_SHOP_DOMAIN=alertproof-dev.myshopify.com
DISABLE_WORKER=1

# Optional custom-shop-domain support from the Shopify template.
SHOP_CUSTOM_DOMAIN=

# Shopify-managed App Pricing page used by the production billing adapter.
# Configure this from Partner Dashboard managed pricing; local billing uses the instant mock.
SHOPIFY_APP_PRICING_URL=
