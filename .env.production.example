# AlertProof production configuration for docker-compose.production.yml.
# Copy to .env.production on the VPS, fill values from the secret manager, then chmod 600.
# Never commit .env.production or paste its values into chat/tickets.

# Traefik/DNS: the Docker network and certificate resolver must already exist on the VPS.
ALERTPROOF_HOST=alertproof.nickbolles.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERT_RESOLVER=CHANGE_ME

# PostgreSQL: use strong values. DATABASE_URL is consumed by the web container.
POSTGRES_USER=alertproof
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=alertproof
DATABASE_URL=postgresql://alertproof:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/alertproof?schema=public

# Required production safety settings.
NODE_ENV=production
AUTH_MODE=shopify
ALERTPROOF_AUTH_BYPASS=0
ALERTPROOF_FORCE_MOCKS=0
DISABLE_WORKER=0
SHOPIFY_API_KEY=CHANGE_ME
SHOPIFY_API_SECRET=CHANGE_ME
SHOPIFY_APP_URL=https://alertproof.nickbolles.com
SCOPES=read_orders,write_orders,read_products,read_inventory
CRON_SECRET=CHANGE_ME_32_OR_MORE_RANDOM_BYTES
# Exactly 32 random bytes, base64 encoded. Back this up separately before use.
ALERTPROOF_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# Email delivery (required for live delivery status).
POSTMARK_API_TOKEN=CHANGE_ME
EMAIL_FROM=alerts@example.com
# HTTP Basic credential passed by Postmark to /webhooks/email-status.
POSTMARK_WEBHOOK_SECRET=CHANGE_ME_USERNAME:CHANGE_ME_PASSWORD

# Contact address shown on the public /support, /privacy, and /terms pages and
# used as the App Store listing support contact. Must be a monitored mailbox.
SUPPORT_EMAIL=support@alertproof.nickbolles.com

# Optional app-funded Twilio SMS. Leave all three unset unless configured together.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Shopify App Pricing page URL.
SHOPIFY_APP_PRICING_URL=
